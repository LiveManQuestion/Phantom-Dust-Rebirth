@echo off
rem Builds pdnet as build\Microsoft.Xbox.Services.dll (x64, static CRT so it needs nothing from the package).
rem Optional argument: a different output folder name, e.g. "build.cmd build-test".
setlocal
set ROOT=%~dp0
set OUT=build
if not "%~1"=="" set OUT=%~1
set VSWHERE="%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
rem -products * so the standalone "Build Tools for Visual Studio" is found too, not only Community/Pro/Enterprise.
for /f "usebackq delims=" %%i in (`%VSWHERE% -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath`) do set VSDIR=%%i
if not defined VSDIR (
    echo Visual Studio C++ tools not found. See BUILDING.md, or install the "Desktop development with C++" workload.
    exit /b 1
)
if not exist "%ProgramFiles(x86)%\Windows Kits\10\Include\10.0.22000.0\um\windows.h" (
    echo Windows SDK 10.0.22000 not found. See BUILDING.md:  winget install Microsoft.WindowsSDK.10.0.22000
    exit /b 1
)
call "%VSDIR%\VC\Auxiliary\Build\vcvarsall.bat" x64 10.0.22000.0 >nul || exit /b 1

rem EOS SDK headers (the SDK DLL itself is loaded at run time). Set EOS_SDK to the SDK's "SDK" folder, or unzip the SDK
rem so that deps\eos-sdk\SDK\Include\eos_sdk.h exists next to the repository's pdnet folder.
if not defined EOS_SDK if exist "%ROOT%..\deps\eos-sdk\SDK\Include\eos_sdk.h" set EOS_SDK=%ROOT%..\deps\eos-sdk\SDK
if not defined EOS_SDK set EOS_SDK=C:\Users\ryhol\tools\downloads\eos-sdk\EOS-SDK-58105819-Release-v1.19.2.1\SDK
set EOSFLAGS=/DPDNET_NO_EOS
if exist "%EOS_SDK%\Include\eos_sdk.h" (set EOSFLAGS=/I"%EOS_SDK%\Include") else (
    echo WARNING: EOS SDK headers not found ^(EOS_SDK=%EOS_SDK%^). Building WITHOUT EOS: no online lobbies. See BUILDING.md.
)

rem XSAPI stand-in (xbox=off): generated by xsapi\generate.py (the winmd comes from NuGet when no path is given).
if not exist "%ROOT%xsapi\gen\module.g.cpp" (
    set PYEXE=
    where py >nul 2>nul && set PYEXE=py
    if not defined PYEXE where python >nul 2>nul && set PYEXE=python
    if not defined PYEXE (
        echo Python 3 not found. See BUILDING.md:  winget install Python.Python.3.12
        exit /b 1
    )
)
if not exist "%ROOT%xsapi\gen\module.g.cpp" (
    %PYEXE% -I "%ROOT%xsapi\generate.py" || goto :genfailed
)

set CFLAGS=/nologo /c /std:c++20 /EHsc /MT /O2 /Zi /W3 /permissive- /bigobj /utf-8 /DUNICODE /D_UNICODE /FS
set XINC=/I"%ROOT%xsapi" /I"%ROOT%xsapi\gen" /I"%ROOT%xsapi\stubs"

if not exist "%ROOT%%OUT%\obj\xsapi" mkdir "%ROOT%%OUT%\obj\xsapi"
pushd "%ROOT%%OUT%"

rem 1. pdnet core
cl %CFLAGS% %EOSFLAGS% /MP /Fo"obj\\" /Fd"obj\core.pdb" ^
   "%ROOT%src\dllmain.cpp" "%ROOT%src\hooks.cpp" "%ROOT%src\gamesave.cpp" "%ROOT%src\log.cpp" ^
   "%ROOT%src\config.cpp" "%ROOT%src\net.cpp" "%ROOT%src\sda.cpp" "%ROOT%src\testpeer.cpp" "%ROOT%src\eostest.cpp" "%ROOT%src\credstore.cpp" ^
   "%ROOT%src\eossdk.cpp" "%ROOT%src\eosclock.cpp" "%ROOT%src\eos.cpp" "%ROOT%src\lobbies.cpp" "%ROOT%src\p2p.cpp" "%ROOT%src\gamepatches.cpp" "%ROOT%src\gamepads.cpp" "%ROOT%src\discord.cpp" "%ROOT%src\scores.cpp" || goto :failed

rem 2. XSAPI stand-in: precompiled header, then every class in parallel
cl %CFLAGS% %XINC% /Yc"xsapi_pch.h" /Fp"obj\xsapi\xsapi.pch" /Fo"obj\xsapi\\" /Fd"obj\xsapi.pdb" "%ROOT%xsapi\xsapi_pch.cpp" || goto :failed
cl %CFLAGS% %XINC% /MP /Yu"xsapi_pch.h" /Fp"obj\xsapi\xsapi.pch" /Fo"obj\xsapi\\" /Fd"obj\xsapi.pdb" ^
   "%ROOT%xsapi\xsapi.cpp" "%ROOT%xsapi\mpsd.cpp" "%ROOT%xsapi\nametrace.cpp" "%ROOT%xsapi\gen\module.g.cpp" "%ROOT%xsapi\stubs\*.cpp" || goto :failed

rem 3. link
link /nologo /DLL /OUT:Microsoft.Xbox.Services.dll /DEF:"%ROOT%src\pdnet.def" /DEBUG /OPT:REF /OPT:ICF ^
   obj\*.obj obj\xsapi\*.obj ^
   kernel32.lib ole32.lib oleaut32.lib runtimeobject.lib ws2_32.lib bcrypt.lib || goto :failed

popd
echo Built %ROOT%%OUT%\Microsoft.Xbox.Services.dll
exit /b 0

:genfailed
echo Generating the XSAPI stand-in failed.
exit /b 1

:failed
set ERR=%ERRORLEVEL%
popd
echo BUILD FAILED
exit /b %ERR%
